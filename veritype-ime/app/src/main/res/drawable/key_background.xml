<?xml version="1.0" encoding="utf-8"?>
<!--
    Keycap drawable with press feedback.
    KeyboardView feeds drawable state (state_pressed) into keyBackground while
    drawing, so a selector gives a physical "travel" feel for free:
    resting keys get a top-lit gradient keycap; pressed keys light up accent.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape xmlns:android="http://schemas.android.com/apk/res/android"
            android:shape="rectangle">
            <solid android:color="@color/key_background_pressed" />
            <stroke android:width="1dp" android:color="@color/key_border_pressed" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item>
        <shape xmlns:android="http://schemas.android.com/apk/res/android"
            android:shape="rectangle">
            <!-- top-lit keycap: lighter face falling off to a darker base -->
            <gradient
                android:angle="270"
                android:startColor="@color/key_face_light"
                android:endColor="@color/key_background" />
            <stroke android:width="1dp" android:color="@color/key_border" />
            <corners android:radius="7dp" />
        </shape>
    </item>
</selector>
